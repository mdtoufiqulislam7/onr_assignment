# =================================================================
# Root Docker Compose Environment Variables (.env.example)
# Copy this file to .env (or modify .env directly)
# =================================================================

# PostgreSQL Database Connection String (Section 1.2)
DATABASE_URL=Host=postgres;Port=5432;Database=admission_db;Username=postgres;Password=postgres

# Redis Cache & Queue Connection String
REDIS_URL=redis:6379

# Seat Hold Duration in Seconds (Section 1.5 Rule 2 - Default: 600)
HOLD_DURATION_SECONDS=600

# Backend URL for Frontend React App (Section 1.2)
VITE_API_URL=http://localhost:8080

