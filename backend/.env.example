# =================================================================
# Backend (.NET 8 Web API) Environment Variables
# =================================================================

# PostgreSQL Connection String
DATABASE_URL=Host=localhost;Port=5432;Database=admission_db;Username=postgres;Password=postgres

# Redis Connection String
REDIS_URL=localhost:6379

# Seat Hold Expiration Duration in Seconds (Default: 600)
HOLD_DURATION_SECONDS=600

# Backend Server URL
ASPNETCORE_URLS=http://+:8080

